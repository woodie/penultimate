{
  "name": "penultimate",
  "version": "0.1.1",
  "description": "A justBeforeEach hook for Vitest, inspired by Quick",
  "keywords": [
    "vitest",
    "justBeforeEach",
    "beforeEach",
    "bdd",
    "rspec",
    "quick",
    "describe",
    "context"
  ],
  "license": "MIT",
  "author": "John Woodell <woodie@netpress.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodie/penultimate.git"
  },
  "homepage": "https://github.com/woodie/penultimate#readme",
  "bugs": "https://github.com/woodie/penultimate/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run --reporter=tree",
    "check": "eslint . && tsc --noEmit && vitest run --reporter=dot",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "@vitest/runner": ">=4.1.0 <5",
    "vitest": ">=4.1.0 <5"
  },
  "devDependencies": {
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/runner": "^4.1.11",
    "eslint": "^10.12.0",
    "neostandard": "^0.14.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
